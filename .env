# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=attendance_db

# Business rules
# Local work-day start time used to flag late punch-ins (24h clock)
WORK_START_HOUR=9
WORK_START_MINUTE=0
# Standard working minutes per day (8h = 480). Beyond this = overtime.
STANDARD_WORK_MINUTES=480
# Grace period in minutes before a punch-in is flagged as late
LATE_GRACE_MINUTES=10
# IANA timezone used to interpret punch times for the "late" rule
TIMEZONE=UTC
